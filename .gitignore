# =============================================================================
# SkillCertify — Client (Frontend) .gitignore
# Vite + React project
# =============================================================================

# -----------------------------------------------------------------------------
# Environment variables & credentials
# .env holds real secrets — NEVER commit it.
# env.example / .env.example must contain ONLY placeholder values, not real keys.
# -----------------------------------------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.env
.envrc
env.example
.env.example

# -----------------------------------------------------------------------------
# Private keys, certificates & secrets
# -----------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa
id_ed25519
credentials.json
firebase-service-account.json
service-account*.json
*-service-account.json
secrets/
private/
certificates/
keys/

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/

# -----------------------------------------------------------------------------
# Build & generated output
# dist/ is a Vite build artifact — regenerated on every build, not source code.
# -----------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.vercel/
.netlify/
.turbo/
.cache/
.parcel-cache/

# -----------------------------------------------------------------------------
# Logs & debug
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Coverage & testing artifacts
# -----------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# -----------------------------------------------------------------------------
# Runtime & temp
# -----------------------------------------------------------------------------
tmp/
temp/
*.pid
*.seed
*.pid.lock
*.tgz
.node_repl_history
.npm
.eslintcache
.yarn-integrity

# -----------------------------------------------------------------------------
# Database & backup files
# (client/lib/ has MongoDB helpers — their connection strings come from .env)
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
backups/
*.bak
*.backup

# -----------------------------------------------------------------------------
# OS-generated files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editor & IDE files
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Upload & user data directories
# -----------------------------------------------------------------------------
uploads/
public/uploads/

# -----------------------------------------------------------------------------
# DO NOT ignore the following (preserved intentionally):
#   package.json        — required
#   package-lock.json   — required for reproducible installs
#   vite.config.js      — required build config
#   tailwind.config.js  — required build config
#   postcss.config.js   — required build config
#   eslint.config.js    — required linting config
#   src/                — all application source code
#   public/             — public static assets
#   index.html          — Vite entry point
#
# NOTE: env.example and .env.example are ignored because this project's
#       env.example currently contains real live credentials. Once the file
#       is sanitised to use only placeholder values, you can remove it from
#       this list so it becomes trackable again as a safe onboarding template.
# -----------------------------------------------------------------------------
